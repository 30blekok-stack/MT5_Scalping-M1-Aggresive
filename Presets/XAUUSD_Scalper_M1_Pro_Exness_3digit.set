; ==================================================================
;  PRESET "TERBAIK" (starting point) - XAUUSD_Scalper_M1_Pro.mq5
;  Untuk BROKER 3 DIGIT seperti EXNESS  ->  1 point = 0.001 USD
;
;  Konversi cepat: 1.00 USD gerak emas = 1000 points.
;    0.10 USD = 100 pt | 0.30 USD = 300 pt | 1.00 USD = 1000 pt
;
;  CEK DULU: pastikan XAUUSD di akun Anda benar-benar 3 desimal
;  (mis. 2345.678). Jika hanya 2 desimal, semua jarak di sini 10x
;  terlalu besar -> bagi 10 (pakai preset broker 2 digit).
;
;  CARA PAKAI:
;   1) Copy file ini ke  <Data Folder>/MQL5/Presets/
;   2) Attach EA ke chart XAUUSD M1 -> tab Inputs -> tombol "Load"
;      -> pilih file .set ini.
;   3) Sesuaikan InpStartHour/InpEndHour ke JAM SERVER broker Anda
;      (Exness umumnya GMT+0; sebagian server GMT+2/+3).
;
;  CATATAN LOT & PARTIAL TP:
;   InpLotSize=0.02 dipakai agar Partial TP 50% bisa jalan
;   (50% dari 0.02 = 0.01 = volume minimum). Jika Anda mau 0.01,
;   Partial TP otomatis dilewati -> set InpUsePartialTP=false.
;   Ingat: lot = risiko. SL 2.00 USD @0.02 lot = -4.00 USD/trade.
; ==================================================================

; --- Moving Average (M1) ---  (0=SMA 1=EMA 2=SMMA 3=LWMA)
InpFastMA=8||5||1||15||N
InpSlowMA=21||15||1||40||N
InpMAMethod=1
InpAppliedPrice=1
InpUseFullCandle=false

; --- Filter 1: Tren HTF (EMA M15) ---
InpUseHTFTrend=true
InpHTFPeriod=50||20||10||100||N

; --- Filter 2: ADX (default M5) ---  (5=M5)
InpUseADX=true
InpADXPeriod=14||10||2||20||N
InpADXTimeframe=5
InpADXThreshold=23.0||18.0||1.0||30.0||N

; --- Filter 3: Slope & Jarak MA (points) ---
;   MinMAGap 120 = 0.12 USD | MaxDist 1200 = 1.20 USD
InpUseMAFilter=true
InpMinMAGapPoints=120||0||50||500||N
InpMaxDistPoints=1200||600||200||3000||N

; --- Filter 4: Sesi / Jam (JAM SERVER, EndHour eksklusif) ---
;   8-22 server ~ sesi London + New York. WAJIB sesuaikan!
InpUseSessionFilter=true
InpStartHour=8
InpEndHour=22

; --- Filter 5: Guard Volatilitas ATR M1 (points) ---
;   Min 100 = 0.10 USD (hindari sepi) | Max 1500 = 1.50 USD (hindari spike)
InpUseATRGuard=true
InpATRPeriod=14||10||2||20||N
InpMinATRPoints=100||0||50||400||N
InpMaxATRPoints=1500||800||200||3000||N

; --- Filter Umum ---
;   MaxSpread 300 = 0.30 USD. Akun Zero/Raw: turunkan ke ~100-150.
InpMaxSpreadPoints=300||100||50||600||N

; --- Stop Loss ---
;   SL tetap 2000 = 2.00 USD. (ATR-stop dimatikan.)
InpUseATRStop=false
InpStopLossPoints=2000||1200||200||4000||N
InpATRStopMult=1.5||1.0||0.25||3.0||N

; --- Profit: Partial TP + Runner ---
;   Partial di 1000 = 1.00 USD, tutup 50%, sekaligus SL -> breakeven.
InpUsePartialTP=true
InpPartialTPPoints=1000||600||200||2500||N
InpPartialClosePercent=50.0

; --- Profit: Breakeven ---
;   Trigger 1200 = 1.20 USD | Buffer 150 = 0.15 USD di atas/bawah entry
InpBreakevenTrigger=1200||800||200||2500||N
InpBreakevenBuffer=150||0||50||500||N

; --- Profit: Trailing (setelah breakeven) ---
;   Distance 1200 = 1.20 USD | Step 250 = 0.25 USD
InpTrailingDistance=1200||600||200||3000||N
InpTrailingStep=250||100||50||600||N

; --- Lot & Identitas ---
InpLotSize=0.02
InpMagicNumber=20250727
