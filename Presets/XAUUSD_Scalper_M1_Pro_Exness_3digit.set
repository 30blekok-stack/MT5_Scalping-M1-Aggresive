; ==================================================================
;  PRESET BASELINE (yang PASTI menghasilkan transaksi) - 3 DIGIT
;  Untuk XAUUSD_Scalper_M1_Pro.mq5 di broker 3 digit (Exness).
;  1 point = 0.001 USD  ->  1.00 USD = 1000 points.
;
;  KENAPA versi lama "tidak ada transaksi"?
;   Kombinasi 5 filter + nilai points terlalu ketat (mis. MinMAGap
;   & ATR guard) bisa memblokir SEMUA entry. Preset ini SENGAJA
;   dilonggarkan: Sesi & ATR-guard OFF, gap MA kecil, spread longgar.
;
;  ALUR PEMAKAIAN:
;   1) Jalankan backtest -> pastikan sekarang ADA transaksi.
;   2) Lihat log "RINGKASAN DIAGNOSTIK EA" di akhir test (Journal),
;      untuk tahu filter mana yang paling banyak menolak.
;   3) Nyalakan filter satu per satu (Sesi -> ATR guard -> naikkan
;      ADX/gap) sambil bandingkan hasil. Set InpDebugMode=true untuk
;      melihat alasan penolakan per sinyal.
;
;  CEK DIGIT: pastikan XAUUSD Anda benar 3 desimal (mis. 2345.678).
;   EA mencetak "SKALA: 100 pt = ..." saat init — kalau angkanya
;   tidak masuk akal, Anda salah preset (pakai versi 2 digit).
;
;  LOT & PARTIAL TP: InpLotSize=0.02 agar partial 50% bisa jalan
;   (0.01 = lot minimum). SL 2000 pt = 2.00 USD @0.02 lot = -4 USD.
; ==================================================================

; --- Moving Average (M1) ---  (0=SMA 1=EMA 2=SMMA 3=LWMA ; price 1=CLOSE)
InpFastMA=8||5||1||15||N
InpSlowMA=21||15||1||40||N
InpMAMethod=1
InpAppliedPrice=1
InpUseFullCandle=false

; --- Filter 1: Tren HTF (EMA M15) : ON (robust, aman) ---
InpUseHTFTrend=true
InpHTFPeriod=50||20||10||100||N

; --- Filter 2: ADX (M5) : ON, threshold rendah dulu ---
InpUseADX=true
InpADXPeriod=14||10||2||20||N
InpADXTimeframe=5
InpADXThreshold=20.0||15.0||1.0||30.0||N

; --- Filter 3: Slope & Jarak MA : ON tapi longgar ---
;   MinMAGap 20 = 0.02 USD | MaxDist 2000 = 2.00 USD
InpUseMAFilter=true
InpMinMAGapPoints=20||0||20||300||N
InpMaxDistPoints=2000||800||200||4000||N

; --- Filter 4: Sesi/Jam : OFF (paling sering jadi "silent killer") ---
;   Nyalakan HANYA setelah tahu JAM SERVER broker Anda.
InpUseSessionFilter=false
InpStartHour=8
InpEndHour=22

; --- Filter 5: Guard ATR M1 : OFF dulu (sangat sensitif skala digit) ---
;   Nilai utk broker 3 digit: Min 30 = 0.03 USD | Max 5000 = 5.00 USD
InpUseATRGuard=false
InpATRPeriod=14||10||2||20||N
InpMinATRPoints=30||0||30||300||N
InpMaxATRPoints=5000||2000||500||8000||N

; --- Filter Umum : spread longgar agar tidak memblokir ---
;   500 = 0.50 USD. Akun Zero/Raw bisa diperketat ke ~150.
InpMaxSpreadPoints=500||100||50||800||N

; --- Stop Loss (tetap) : 2000 = 2.00 USD ---
InpUseATRStop=false
InpStopLossPoints=2000||1200||200||4000||N
InpATRStopMult=1.5||1.0||0.25||3.0||N

; --- Profit: Partial TP : 1000 = 1.00 USD, tutup 50% + SL->breakeven ---
InpUsePartialTP=true
InpPartialTPPoints=1000||600||200||2500||N
InpPartialClosePercent=50.0

; --- Profit: Breakeven : trigger 1200=1.20 | buffer 150=0.15 USD ---
InpBreakevenTrigger=1200||800||200||2500||N
InpBreakevenBuffer=150||0||50||500||N

; --- Profit: Trailing : distance 1200=1.20 | step 250=0.25 USD ---
InpTrailingDistance=1200||600||200||3000||N
InpTrailingStep=250||100||50||600||N

; --- Lot & Identitas ---
InpLotSize=0.02
InpMagicNumber=20250727

; --- Diagnostik : set true utk melihat alasan tiap sinyal ditolak ---
InpDebugMode=false
