; ==================================================================
;  PRESET BASELINE (yang PASTI menghasilkan transaksi) - 2 DIGIT
;  Untuk XAUUSD_Scalper_M1_Pro.mq5 di broker 2 digit.
;  1 point = 0.01 USD  ->  1.00 USD = 100 points.
;
;  Ini versi 2 digit (semua nilai points = 1/10 dari preset 3 digit).
;  PAKAI INI bila EA mencetak "Digits=2" di log saat init, atau bila
;  XAUUSD Anda tampil 2 desimal (mis. 2345.67).
;
;  Sama seperti versi 3 digit: Sesi & ATR-guard OFF dulu supaya ADA
;  transaksi; lalu perketat filter sambil lihat "RINGKASAN DIAGNOSTIK".
;
;  LOT & PARTIAL TP: InpLotSize=0.02 agar partial 50% bisa jalan.
;   SL 200 pt = 2.00 USD @0.02 lot = -4 USD/trade.
; ==================================================================

; --- Moving Average (M1) ---  (0=SMA 1=EMA 2=SMMA 3=LWMA ; price 1=CLOSE)
InpFastMA=8||5||1||15||N
InpSlowMA=21||15||1||40||N
InpMAMethod=1
InpAppliedPrice=1
InpUseFullCandle=false

; --- Filter 1: Tren HTF (EMA M15) : ON ---
InpUseHTFTrend=true
InpHTFPeriod=50||20||10||100||N

; --- Filter 2: ADX (M5) : ON (threshold unitless, sama spt 3 digit) ---
InpUseADX=true
InpADXPeriod=14||10||2||20||N
InpADXTimeframe=5
InpADXThreshold=20.0||15.0||1.0||30.0||N

; --- Filter 3: Slope & Jarak MA : ON tapi longgar ---
;   MinMAGap 2 = 0.02 USD | MaxDist 200 = 2.00 USD
InpUseMAFilter=true
InpMinMAGapPoints=2||0||2||30||N
InpMaxDistPoints=200||80||20||400||N

; --- Filter 4: Sesi/Jam : OFF dulu (sesuaikan JAM SERVER lalu ON) ---
InpUseSessionFilter=false
InpStartHour=8
InpEndHour=22

; --- Filter 5: Guard ATR M1 : OFF dulu ---
;   Nilai 2 digit: Min 3 = 0.03 USD | Max 500 = 5.00 USD
InpUseATRGuard=false
InpATRPeriod=14||10||2||20||N
InpMinATRPoints=3||0||3||30||N
InpMaxATRPoints=500||200||50||800||N

; --- Filter Umum : 50 = 0.50 USD ---
InpMaxSpreadPoints=50||10||5||80||N

; --- Stop Loss (tetap) : 200 = 2.00 USD ---
InpUseATRStop=false
InpStopLossPoints=200||120||20||400||N
InpATRStopMult=1.5||1.0||0.25||3.0||N

; --- Profit: Partial TP : 100 = 1.00 USD, tutup 50% + SL->breakeven ---
InpUsePartialTP=true
InpPartialTPPoints=100||60||20||250||N
InpPartialClosePercent=50.0

; --- Profit: Breakeven : trigger 120=1.20 | buffer 15=0.15 USD ---
InpBreakevenTrigger=120||80||20||250||N
InpBreakevenBuffer=15||0||5||50||N

; --- Profit: Trailing : distance 120=1.20 | step 25=0.25 USD ---
InpTrailingDistance=120||60||20||300||N
InpTrailingStep=25||10||5||60||N

; --- Lot & Identitas ---
InpLotSize=0.02
InpMagicNumber=20250727

; --- Diagnostik : set true utk melihat alasan tiap sinyal ditolak ---
InpDebugMode=false
